# Server-side Gemini API key (stored in Secret Manager for Firebase Cloud Functions,
# and configured in Settings > Secrets for the local Express server).
# NEVER expose this key to the browser or prefix with VITE_ / NEXT_PUBLIC_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL used for links and server callbacks.
APP_URL="http://localhost:3000"

# Bootstrap Super Admin email for server-side verification (must match verified Firebase Auth email).
BOOTSTRAP_SUPER_ADMIN_EMAIL="onlineguard515@gmail.com"

# Optional override for Firebase project ID in Cloud Functions / Express verification.
# Defaults to projectId in firebase-applet-config.json when unset.
FIREBASE_PROJECT_ID="commanding-obelisk-5vc14"
